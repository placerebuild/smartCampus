{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server --omit=dev",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": ["syd1"],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/certs/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/", "destination": "/html/index.html" },
    { "source": "/index.html", "destination": "/html/index.html" },
    { "source": "/dashboard.html", "destination": "/html/index.html" },
    { "source": "/devices.html", "destination": "/html/devices.html" },
    { "source": "/topology.html", "destination": "/html/topology.html" },
    { "source": "/alerts.html", "destination": "/html/alerts.html" },
    { "source": "/reports.html", "destination": "/html/reports.html" },
    { "source": "/profile.html", "destination": "/html/profile.html" },
    { "source": "/settings.html", "destination": "/html/settings.html" },
    { "source": "/login.html", "destination": "/html/login.html" },
    { "source": "/signup.html", "destination": "/html/signup.html" },
    { "source": "/mainpage.html", "destination": "/html/mainpage.html" },
    { "source": "/users.html", "destination": "/html/users.html" },
    { "source": "/activity.html", "destination": "/html/activity.html" },
    { "source": "/management.html", "destination": "/html/management.html" }
  ]
}
